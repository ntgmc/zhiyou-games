# Replace play.example.com and /srv/zhiyou-games with your domain and dist location.
play.example.com {
    root * /srv/zhiyou-games
    encode zstd gzip

    @metadata path /_headers /.nojekyll
    respond @metadata 404

    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        X-Frame-Options DENY
        Cache-Control "public, max-age=0, must-revalidate"
        Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; media-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
    @versioned path /static/*
    header @versioned Cache-Control "public, max-age=31536000, immutable"

    file_server
    handle_errors {
        rewrite * /404.html
        file_server
    }
}
